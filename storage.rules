rules_version = '2';
// Narrative: docs/security.md
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isRecipeLibraryAdmin() {
      return signedIn() && request.auth.token.recipeLibraryAdmin == true;
    }

    match /recipes/library/{recipeId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isRecipeLibraryAdmin();
    }

    match /recipes/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /pantry/{uid}/{itemId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
